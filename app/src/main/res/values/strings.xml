    <string name="insp_macros_detail">Programs inside the document (VBA). Hramota never runs them. Take care opening this file in other apps.</string>
    <string name="insp_js">JavaScript</string>
    <string name="insp_js_detail">Code in the PDF. It cannot run in Hramota: the PDF engine is built without JavaScript.</string>
    <string name="insp_launch">program launch</string>
    <string name="insp_launch_detail">Links that try to open another program or file. Hramota does not follow them.</string>
    <string name="insp_embedded_detail">Files and objects inside the document: %1$s. Hramota does not open them by itself.</string>
    <string name="insp_remote">internet downloads</string>
    <string name="insp_remote_detail">The document wants to load a template or picture from the internet, sometimes used to track who opened it. Hramota has no internet access, so nothing is loaded.</string>
    <string name="insp_dde">DDE fields</string>
    <string name="insp_dde_detail">An old way to run commands from a document. Shown as text only.</string>
    <string name="insp_links_detail">Links to websites. Hramota shows the real address before opening anything.</string>
    <string name="insp_changes">tracked changes</string>
    <string name="insp_changes_detail">The file keeps revisions (added and deleted text). Anyone you send it to will see them.</string>
    <string name="insp_comments_detail">Comments in the document. Recipients will see them.</string>
    <string name="insp_hidden">hidden text</string>
